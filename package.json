{
  "name": "fleet-ai-agent",
  "version": "0.1.0",
  "description": "A TypeScript AI fleet-manager agent: AWS Bedrock (Converse) + MCP tool use + RAG, talking to the fleet-mcp-server.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p tsconfig.json",
    "serve": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.658.0",
    "@modelcontextprotocol/sdk": "^1.4.0",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "@smithy/types": "^3.3.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "license": "MIT"
}
