# --- LLM backend ---------------------------------------------------------
# bedrock | openai-compatible | mock
LLM_PROVIDER=bedrock

# Bedrock (production path; mirrors the original Spring AI setup)
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=amazon.nova-lite-v1:0
# AWS credentials come from the standard chain (env, ~/.aws, IAM role).

# OpenAI-compatible (free path). Examples:
#   Groq:       OPENAI_BASE_URL=https://api.groq.com/openai/v1   OPENAI_MODEL=llama-3.3-70b-versatile
#   Ollama:     OPENAI_BASE_URL=http://localhost:11434/v1        OPENAI_MODEL=llama3.1   (no key)
#   OpenRouter: OPENAI_BASE_URL=https://openrouter.ai/api/v1     OPENAI_MODEL=...:free
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_API_KEY=
OPENAI_MODEL=llama-3.3-70b-versatile

# --- MCP server connection ----------------------------------------------
# stdio: spawn the python server (default) | http: connect to a running one
MCP_TRANSPORT=stdio
MCP_COMMAND=fleet-mcp-server
MCP_ARGS=
# For MCP_TRANSPORT=http:
MCP_URL=http://localhost:8080/mcp

# --- server --------------------------------------------------------------
PORT=3000
MAX_TOOL_ITERATIONS=6

# --- guardrails, budget & tracing ----------------------------------------
# allow | approval | deny  (policy for side-effecting tools)
WRITE_TOOL_POLICY=approval
MAX_TOKENS_PER_RUN=50000
MAX_COST_USD_PER_RUN=0.05
# Override the built-in price table (USD per 1M tokens)
PRICE_INPUT_PER_MTOK=
PRICE_OUTPUT_PER_MTOK=
# JSONL trajectory log; empty disables
TRAJECTORY_FILE=runs/trajectories.jsonl
# Eval CI gate
EVAL_MIN_PASS_RATE=0.8
